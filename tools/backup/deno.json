{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "tasks": {
    "fmt:check": "deno fmt --check .",
    "lint": "deno lint .",
    "check": "deno check archive.ts crypto.ts workflow.ts archive_test.ts crypto_test.ts workflow_test.ts",
    "test": "deno test --allow-read --allow-write archive_test.ts crypto_test.ts workflow_test.ts"
  }
}
