{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design.schema.json",
  "title": "AI OS Technical Design",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_id", "source_brief", "decisions", "coverage", "risk_triggers", "unresolved_questions", "approval"],
  "properties": {
    "work_id": {"type": "string", "minLength": 1},
    "source_brief": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "area", "decision", "rationale", "reversibility"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "area": {"type": "string", "enum": ["data", "interface", "business-rule", "ui", "security", "architecture", "operations", "other"]},
          "decision": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "alternatives": {"type": "array", "items": {"type": "string"}},
          "reversibility": {"type": "string", "enum": ["easy", "moderate", "hard"]}
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ac_id", "design_refs"],
        "properties": {
          "ac_id": {"type": "string", "pattern": "^AC-[0-9]+$"},
          "design_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "risk_triggers": {"type": "array", "items": {"type": "string"}},
    "required_reviews": {"type": "array", "items": {"type": "string", "enum": ["architecture", "security", "privacy", "data", "operations"]}},
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "blocking", "owner"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"},
          "owner": {"type": "string"}
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "by", "at", "reason"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
        "by": {"type": "string"},
        "at": {"type": "string"},
        "reason": {"type": "string"}
      }
    }
  }
}
