{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release.schema.json",
  "title": "AI OS Release Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_id", "source_review", "deployment_strategy", "rollout", "monitoring", "rollback", "support_owner", "blockers", "approval"],
  "properties": {
    "work_id": {"type": "string", "minLength": 1},
    "source_review": {"type": "string", "minLength": 1},
    "deployment_strategy": {"type": "string", "minLength": 1},
    "rollout": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "monitoring": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "success", "failure"],
        "properties": {
          "signal": {"type": "string", "minLength": 1},
          "success": {"type": "string", "minLength": 1},
          "failure": {"type": "string", "minLength": 1}
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "plan"],
      "properties": {
        "required": {"type": "boolean"},
        "plan": {"type": "string"}
      }
    },
    "support_owner": {"type": "string", "minLength": 1},
    "communications": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "by", "at", "reason"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
        "by": {"type": "string"},
        "at": {"type": "string"},
        "reason": {"type": "string"}
      }
    }
  }
}
