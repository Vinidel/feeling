{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "implementation.schema.json",
  "title": "AI OS Implementation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_id", "source_plan", "stages", "unresolved_questions"],
  "properties": {
    "work_id": {"type": "string", "minLength": 1},
    "source_plan": {"type": "string", "minLength": 1},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "files_changed", "test_evidence", "notes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pending", "in_progress", "blocked", "complete"]},
          "files_changed": {"type": "array", "items": {"type": "string"}},
          "test_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "result", "details"],
              "properties": {
                "command": {"type": "string", "minLength": 1},
                "result": {"type": "string", "enum": ["pass", "fail", "not_run"]},
                "details": {"type": "string"}
              }
            }
          },
          "notes": {"type": "string"}
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "blocking", "owner"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"},
          "owner": {"type": "string"}
        }
      }
    }
  }
}
