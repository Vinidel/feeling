{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "imports": {
    "jose": "npm:jose@6.2.9",
    "postgres": "npm:postgres@3.4.9",
    "zod": "npm:zod@4.4.3"
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "nodeModulesDir": "none",
  "minimumDependencyAge": 1440,
  "tasks": {
    "check": "deno check src/main.ts tests/",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "start": "deno run --frozen --cached-only --no-prompt --allow-env=AUTH0_AUDIENCE,AUTH0_ISSUER,CORS_ORIGINS,DATABASE_SSL_MODE,DATABASE_URL,DEPLOYMENT_VERSION,HOST,PORT --ignore-env=PG* --allow-net=0.0.0.0:8080,dev-vin.au.auth0.com:443,aws-0-ap-southeast-2.pooler.supabase.com:6543 src/main.ts",
    "test": "deno test --frozen --no-prompt --ignore-env=PG* --allow-net=127.0.0.1"
  }
}
